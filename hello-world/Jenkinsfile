pipeline {
    agent any

    environment {
        IMAGE_NAME = 'hello-world'
        IMAGE_TAG = "${BUILD_NUMBER}"
        APP_DIR = 'hello-world'
        MAVEN_CMD = 'C:\\Program Files\\apache-maven-3.9.15-bin\\apache-maven-3.9.15\\bin\\mvn.cmd'
        DOCKER_CMD = 'C:\\Users\\PranaliLambe\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        KUBECTL_CMD = 'C:\\Users\\PranaliLambe\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\kubectl.exe'
        KUBECONFIG_FILE = 'C:\\Users\\PranaliLambe\\.kube\\config'
        KUBE_CONTEXT = 'docker-desktop'
    }

    stages {
        stage('Test') {
            steps {
                bat 'cd /d "%WORKSPACE%\\%APP_DIR%" && "%MAVEN_CMD%" clean test'
            }
        }

        stage('Package') {
            steps {
                bat 'cd /d "%WORKSPACE%\\%APP_DIR%" && "%MAVEN_CMD%" clean package -DskipTests && if not exist target\\*.jar (echo No JAR was created in target && exit /b 1) && dir /b target\\*.jar'
            }
        }

        stage('Docker Build and Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat 'echo %DOCKER_PASSWORD%| "%DOCKER_CMD%" login --username %DOCKER_USERNAME% --password-stdin'
                    bat 'cd /d "%WORKSPACE%\\%APP_DIR%" && if not exist target\\*.jar (echo No JAR found in target && exit /b 1) && "%DOCKER_CMD%" buildx build --progress=plain --push -t %DOCKER_USERNAME%/%IMAGE_NAME%:%IMAGE_TAG% -t %DOCKER_USERNAME%/%IMAGE_NAME%:latest .'
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat '"%KUBECTL_CMD%" --kubeconfig "%KUBECONFIG_FILE%" --context "%KUBE_CONTEXT%" cluster-info'
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat 'echo Docker Hub Kubernetes pull secret setup'
                    bat '"%KUBECTL_CMD%" --kubeconfig "%KUBECONFIG_FILE%" --context "%KUBE_CONTEXT%" create secret docker-registry dockerhub-registry --docker-server=https://index.docker.io/v1/ --docker-username=%DOCKER_USERNAME% --docker-password=%DOCKER_PASSWORD% --dry-run=client -o yaml | "%KUBECTL_CMD%" --kubeconfig "%KUBECONFIG_FILE%" --context "%KUBE_CONTEXT%" apply -f -'
                    bat 'cd /d "%WORKSPACE%\\%APP_DIR%" && "%KUBECTL_CMD%" --kubeconfig "%KUBECONFIG_FILE%" --context "%KUBE_CONTEXT%" apply -f k8s/deployment.yaml'
                    bat '"%KUBECTL_CMD%" --kubeconfig "%KUBECONFIG_FILE%" --context "%KUBE_CONTEXT%" set image deployment/hello-world hello-world=%DOCKER_USERNAME%/%IMAGE_NAME%:%IMAGE_TAG%'
                    bat '"%KUBECTL_CMD%" --kubeconfig "%KUBECONFIG_FILE%" --context "%KUBE_CONTEXT%" rollout status deployment/hello-world'
                }
            }
        }
    }

    post {
        always {
            bat '"%DOCKER_CMD%" logout'
        }
    }
}
