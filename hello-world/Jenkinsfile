pipeline {
    agent any

    environment {
        DOCKER_IMAGE = 'your-dockerhub-username/hello-world'
        IMAGE_TAG = "${BUILD_NUMBER}"
        MAVEN_CMD = 'C:\\Program Files\\apache-maven-3.9.15-bin\\apache-maven-3.9.15\\bin\\mvn.cmd'
        DOCKER_CMD = 'C:\\Users\\PranaliLambe\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        KUBECTL_CMD = 'C:\\Users\\PranaliLambe\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\kubectl.exe'
    }

    stages {
        stage('Test') {
            steps {
                bat '"%MAVEN_CMD%" clean test'
            }
        }

        stage('Package') {
            steps {
                bat '"%MAVEN_CMD%" package -DskipTests'
            }
        }

        stage('Docker Build') {
            steps {
                bat '"%DOCKER_CMD%" build -t %DOCKER_IMAGE%:%IMAGE_TAG% .'
                bat '"%DOCKER_CMD%" tag %DOCKER_IMAGE%:%IMAGE_TAG% %DOCKER_IMAGE%:latest'
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat 'echo %DOCKER_PASSWORD%| "%DOCKER_CMD%" login --username %DOCKER_USERNAME% --password-stdin'
                    bat '"%DOCKER_CMD%" push %DOCKER_IMAGE%:%IMAGE_TAG%'
                    bat '"%DOCKER_CMD%" push %DOCKER_IMAGE%:latest'
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat '"%KUBECTL_CMD%" apply -f k8s/deployment.yaml'
                bat '"%KUBECTL_CMD%" set image deployment/hello-world hello-world=%DOCKER_IMAGE%:%IMAGE_TAG%'
                bat '"%KUBECTL_CMD%" rollout status deployment/hello-world'
            }
        }
    }

    post {
        always {
            bat '"%DOCKER_CMD%" logout'
        }
    }
}
