pipeline {
    agent any

    environment {
        IMAGE_NAME = 'hello-world'
        IMAGE_TAG = "${BUILD_NUMBER}"
        APP_DIR = 'hello-world'
        MAVEN_CMD = 'C:\\Program Files\\apache-maven-3.9.15-bin\\apache-maven-3.9.15\\bin\\mvn.cmd'
        DOCKER_CMD = 'C:\\Users\\PranaliLambe\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\docker.exe'
        KUBECTL_CMD = 'C:\\Users\\PranaliLambe\\AppData\\Local\\Programs\\DockerDesktop\\resources\\bin\\kubectl.exe'
    }

    stages {
        stage('Test') {
            steps {
                bat 'cd /d "%WORKSPACE%\\%APP_DIR%" && "%MAVEN_CMD%" clean test'
            }
        }

        stage('Package') {
            steps {
                bat 'cd /d "%WORKSPACE%\\%APP_DIR%" && "%MAVEN_CMD%" clean package -DskipTests && if not exist target\\*.jar (echo No JAR was created in target && exit /b 1) && dir /b target\\*.jar'
            }
        }

        stage('Docker Build') {
            steps {
                bat 'cd /d "%WORKSPACE%\\%APP_DIR%" && if not exist target\\*.jar (echo No JAR found in target && exit /b 1) && "%DOCKER_CMD%" build --progress=plain -t %IMAGE_NAME%:%IMAGE_TAG% -t %IMAGE_NAME%:latest . && "%DOCKER_CMD%" image inspect %IMAGE_NAME%:%IMAGE_TAG%'
            }
        }

        stage('Docker Push') {
            steps {
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat 'echo Docker Push stage started for build %BUILD_NUMBER%'
                    bat '"%DOCKER_CMD%" image inspect %IMAGE_NAME%:%IMAGE_TAG%'
                    bat 'echo %DOCKER_PASSWORD%| "%DOCKER_CMD%" login --username %DOCKER_USERNAME% --password-stdin'
                    bat '"%DOCKER_CMD%" tag %IMAGE_NAME%:%IMAGE_TAG% %DOCKER_USERNAME%/%IMAGE_NAME%:%IMAGE_TAG%'
                    bat '"%DOCKER_CMD%" tag %IMAGE_NAME%:latest %DOCKER_USERNAME%/%IMAGE_NAME%:latest'
                    bat 'echo Pushing %DOCKER_USERNAME%/%IMAGE_NAME%:%IMAGE_TAG%'
                    bat '"%DOCKER_CMD%" push %DOCKER_USERNAME%/%IMAGE_NAME%:%IMAGE_TAG%'
                    bat 'echo Pushing %DOCKER_USERNAME%/%IMAGE_NAME%:latest'
                    bat '"%DOCKER_CMD%" push %DOCKER_USERNAME%/%IMAGE_NAME%:latest'
                }
            }
        }

        stage('Deploy to Kubernetes') {
            steps {
                bat 'cd /d "%WORKSPACE%\\%APP_DIR%" && "%KUBECTL_CMD%" apply -f k8s/deployment.yaml'
                withCredentials([
                    usernamePassword(
                        credentialsId: 'dockerhub-credentials',
                        usernameVariable: 'DOCKER_USERNAME',
                        passwordVariable: 'DOCKER_PASSWORD'
                    )
                ]) {
                    bat '"%KUBECTL_CMD%" set image deployment/hello-world hello-world=%DOCKER_USERNAME%/%IMAGE_NAME%:%IMAGE_TAG%'
                    bat '"%KUBECTL_CMD%" rollout status deployment/hello-world'
                }
            }
        }
    }

    post {
        always {
            bat '"%DOCKER_CMD%" logout'
        }
    }
}
